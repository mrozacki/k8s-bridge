# Multi-stage build for the ray-bridge controller (sibling to k8s-bridge,
# ADR-0012 — separate binary, separate image, shares the internal library).
# Build context is this directory (.).
# L4 (base images pinned by digest, closes backlog SEC2): tag kept for
# readability, digest is what is actually pulled — same pin, same reasoning and
# deliberately the same digest as the k8s-bridge image, so the two binaries are
# always built by an identical toolchain. See Dockerfile for the full note.
FROM golang:1.27@sha256:65b6f280bf050ec5af12716857e8ea8439d694dbba8f31ceeb7630670071f2bb AS build
WORKDIR /src

# Cache module downloads separately from source changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO_ENABLED=0 static binary for the distroless/static base; -trimpath keeps
# build-machine paths out of the binary. Same conventions as the k8s-bridge
# image.
RUN CGO_ENABLED=0 GOFLAGS=-trimpath go build -o /out/ray-bridge ./cmd/ray-bridge

# Digest-pinned (L4 / SEC2) and kept identical to the k8s-bridge image's base.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35
COPY --from=build /out/ray-bridge /ray-bridge

ENTRYPOINT ["/ray-bridge"]
